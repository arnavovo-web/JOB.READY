# Supabase public browser configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Never put private/server secrets in this file.
# Anthropic API keys and Supabase service-role keys belong only in server-side/Edge Function secrets.

# Phase 40 (pricing/payments): the browser needs NO Stripe variable — checkout is created by
# the create-checkout Edge Function and the browser only redirects to the returned URL.
# STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET (and optional PUBLIC_SITE_URL) are set ONLY as
# Supabase Edge Function secrets. See supabase/functions/README.md.

# Optional — only needed to run `npm run evaluate:interview-invitations` (a real-AI-call
# evaluation of the Interview Invitation Scanner against src/test-fixtures/interview-invitations/).
# Never required for the normal test suite (`npm test`). See src/invitationScannerLiveEvaluation.test.js.
INVITATION_EVAL_EMAIL=
INVITATION_EVAL_PASSWORD=
